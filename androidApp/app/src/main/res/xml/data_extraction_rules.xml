<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ 的备份/迁移规则：本应用不把任何进程数据交给云备份或换机迁移
    （与 android:allowBackup="false" 一致，密钥与会话都在内存里）。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
