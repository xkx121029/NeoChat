<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>NeoChat.Windows</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>

    <!--
      非打包（unpackaged）应用不需要 resources.pri，但 Windows App SDK 的 PRI / MSIX 目标会调用
      Microsoft.Build.Packaging.Pri.Tasks.dll 与 Microsoft.Build.AppxPackage.dll，这两个任务程序集
      只随 Visual Studio 的 UWP / Windows App SDK 工作负载安装。本机（用户态 .NET SDK，无该工作负载）
      MSBuild 找不到它们，报 MSB4062。关掉这两步后构建可完成；有该工作负载的机器上同样成立。
    -->
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <IncludeCopyLocalFilesOutputGroup>false</IncludeCopyLocalFilesOutputGroup>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NeoChat.Domain\NeoChat.Domain.csproj" />
    <ProjectReference Include="..\NeoChat.Protocol\NeoChat.Protocol.csproj" />
    <ProjectReference Include="Core\NeoChat.Windows.Core.csproj" />
  </ItemGroup>

  <!-- Core 与 Tests 是同级工程，不参与 WinUI 应用的编译。 -->
  <ItemGroup>
    <Compile Remove="Core\**\*.cs" />
    <Compile Remove="Tests\**\*.cs" />
    <Page Remove="Core\**" />
    <Page Remove="Tests\**" />
    <None Remove="Core\**" />
    <None Remove="Tests\**" />
  </ItemGroup>

</Project>
