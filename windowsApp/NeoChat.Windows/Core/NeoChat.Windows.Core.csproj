<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>NeoChat.Windows.Core</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\NeoChat.Protocol\NeoChat.Protocol.csproj" />
  </ItemGroup>

  <!--
    spec/schema/v1.sql 是双端共用的唯一 DDL。这里把它原样编进程序集，启动时直接 executescript，
    而不是在 C# 里重写一份建表语句：DDL 改动只有一处，schema-diff 比对的就是应用真正执行的那份文本。
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\spec\schema\v1.sql" LogicalName="NeoChat.Windows.Core.Storage.v1.sql" />
  </ItemGroup>

</Project>
