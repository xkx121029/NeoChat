<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NeoChat.Windows.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chat="using:NeoChat.Windows.Core.Chat"
    xmlns:markdown="using:NeoChat.Windows.Views.Markdown"
    xmlns:views="using:NeoChat.Windows.Views"
    Background="{StaticResource BrushPageGradient}">

    <Page.Resources>

        <!-- §2.1 用户气泡：右对齐、82% 宽上限（MaxWidth 在 code-behind 按 Y11 计算）、lg 圆角、16/8 内边距 -->
        <DataTemplate x:Key="UserMessageTemplate" x:DataType="chat:ChatMessageItem">
            <Border
                x:Name="UserBubbleBorder"
                HorizontalAlignment="Right"
                Background="{StaticResource BrushBubble}"
                CornerRadius="{StaticResource RadiusLg}"
                Padding="{StaticResource ThicknessBubble}">
                <TextBlock
                    FontSize="{StaticResource FontSizeBodyLarge}"
                    FontWeight="{StaticResource WeightRegular}"
                    Foreground="{StaticResource BrushInk}"
                    IsTextSelectionEnabled="True"
                    LineHeight="{StaticResource LineHeightBodyLarge}"
                    LineStackingStrategy="BlockLineHeight"
                    Text="{x:Bind Text, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </Border>
        </DataTemplate>

        <!-- §2.1 助手消息：无框全宽正文 + 思考行 + 流式光标 + 中断标记 -->
        <DataTemplate x:Key="AssistantMessageTemplate" x:DataType="chat:ChatMessageItem">
            <StackPanel Spacing="{StaticResource SpaceXs}">

                <!-- §3.6 过程行几何：lead 24 / gap 8 / 文字列起点 32 / 单行最小高 32 -->
                <Grid
                    MinHeight="{StaticResource LayoutStreamRowMinHeight}"
                    Background="{StaticResource BrushTransparent}"
                    Padding="{StaticResource ThicknessStreamRow}"
                    Tapped="OnThinkingRowTapped"
                    Visibility="{x:Bind HasReasoning, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="{StaticResource LayoutStreamLead}"
                        Height="{StaticResource LayoutStreamLead}"
                        VerticalAlignment="Top"
                        Background="{StaticResource BrushSeedContainer}"
                        CornerRadius="{StaticResource RadiusXs}">
                        <FontIcon
                            FontFamily="{StaticResource FontIcon}"
                            FontSize="{StaticResource LayoutIconGlyphSize}"
                            Foreground="{StaticResource BrushSeed}"
                            Glyph="&#xE9D9;" />
                    </Border>
                    <StackPanel
                        Grid.Column="1"
                        Margin="{StaticResource ThicknessStreamTextIndent}"
                        VerticalAlignment="Top">
                        <TextBlock
                            FontSize="{StaticResource FontSizeBodyMedium}"
                            Foreground="{StaticResource BrushInkMuted}"
                            LineHeight="{StaticResource LineHeightStreamRowLabel}"
                            Text="{x:Bind ReasoningLabel, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="ThinkingDetail"
                            FontSize="{StaticResource FontSizeStreamRowDetail}"
                            Foreground="{StaticResource BrushInkFaint}"
                            LineHeight="{StaticResource LineHeightStreamRowDetail}"
                            MaxLines="{StaticResource LayoutThinkingWindowLinesInt}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <FontIcon
                        x:Name="ThinkingChevron"
                        Grid.Column="2"
                        FontSize="{StaticResource LayoutIconGlyphSize}"
                        Foreground="{StaticResource BrushInkGhost}"
                        Glyph="&#xE70D;"
                        VerticalAlignment="Top" />
                </Grid>

                <!-- ST04 等待首个 token：三点错峰（§5 差异 6） -->
                <StackPanel
                    x:Name="WaitingDots"
                    Orientation="Horizontal"
                    Spacing="{StaticResource SpaceXs}"
                    Visibility="{x:Bind ShowWaitingIndicator, Mode=OneWay}">
                    <Ellipse
                        Width="{StaticResource LayoutStatusDotSize}"
                        Height="{StaticResource LayoutStatusDotSize}"
                        Fill="{StaticResource BrushInkGhost}" />
                    <Ellipse
                        Width="{StaticResource LayoutStatusDotSize}"
                        Height="{StaticResource LayoutStatusDotSize}"
                        Fill="{StaticResource BrushInkGhost}" />
                    <Ellipse
                        Width="{StaticResource LayoutStatusDotSize}"
                        Height="{StaticResource LayoutStatusDotSize}"
                        Fill="{StaticResource BrushInkGhost}" />
                </StackPanel>

                <!-- §2.1 正文：Markdown → RenderModel 渲染（spec/render-model.md），
                     bodyLarge 16 / 1.65 + 块级排版 + 末尾流式光标（ST01/ST02） -->
                <markdown:MarkdownHost x:Name="AssistantBody" />

                <!-- Y26 中断标记：图 16 + 间距 4 + bodySmall，danger 色 -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="{StaticResource SpaceXs}"
                    Visibility="{x:Bind ShowInterruptedMarker, Mode=OneWay}">
                    <FontIcon
                        FontFamily="{StaticResource FontIcon}"
                        FontSize="{StaticResource LayoutInterruptedIconSize}"
                        Foreground="{StaticResource BrushDanger}"
                        Glyph="&#xE71A;" />
                    <TextBlock
                        FontSize="{StaticResource FontSizeBodySmall}"
                        Foreground="{StaticResource BrushDanger}"
                        LineHeight="{StaticResource LineHeightBodySmall}"
                        Text="已停止" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <views:ChatMessageTemplateSelector
            x:Key="MessageTemplate"
            Assistant="{StaticResource AssistantMessageTemplate}"
            User="{StaticResource UserMessageTemplate}" />
    </Page.Resources>

    <Grid>
        <!-- G15 页面光晕：glowPrimary 右上 / glowSecondary 左下 -->
        <Ellipse
            Width="{StaticResource LayoutGlowDiameter}"
            Height="{StaticResource LayoutGlowDiameter}"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Fill="{StaticResource BrushGlowPrimary}"
            IsHitTestVisible="False" />
        <Ellipse
            Width="{StaticResource LayoutGlowDiameter}"
            Height="{StaticResource LayoutGlowDiameter}"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Fill="{StaticResource BrushGlowSecondary}"
            IsHitTestVisible="False" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- §2.3 顶部栏：高 56、水平内边距 12、左圆钮 22、标题胶囊 44、右模型胶囊 44 -->
            <Grid Grid.Row="0" Height="{StaticResource LayoutHeaderHeight}" Margin="{StaticResource ThicknessHeader}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Width="{StaticResource LayoutHeaderKeySize}"
                    Height="{StaticResource LayoutHeaderKeySize}"
                    Padding="{StaticResource ThicknessZero}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="新对话"
                    Background="{StaticResource BrushTransparent}"
                    BorderThickness="0"
                    Click="OnNewConversationClick">
                    <FontIcon
                        FontFamily="{StaticResource FontIcon}"
                        FontSize="{StaticResource LayoutHeaderIconSize}"
                        Foreground="{StaticResource BrushInk}"
                        Glyph="&#xE710;" />
                </Button>

                <Border
                    Grid.Column="1"
                    MinHeight="{StaticResource LayoutHeaderCapsuleMinHeight}"
                    Margin="{StaticResource ThicknessHeaderTitle}"
                    Padding="{StaticResource ThicknessHeaderTitle}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{StaticResource BrushChromeFill}"
                    BorderBrush="{StaticResource BrushChromeHairline}"
                    BorderThickness="{StaticResource BorderHairline}"
                    CornerRadius="{StaticResource RadiusCapsule}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource LayoutStatusDotGap}" VerticalAlignment="Center">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="{StaticResource FontSizeTitleSmall}"
                            Foreground="{StaticResource BrushInk}"
                            LineHeight="{StaticResource LineHeightTitleSmall}"
                            Text="{x:Bind ViewModel.SessionTitle}" />
                        <Ellipse
                            x:Name="StatusDot"
                            Width="{StaticResource LayoutStatusDotSize}"
                            Height="{StaticResource LayoutStatusDotSize}"
                            VerticalAlignment="Center"
                            Fill="{StaticResource BrushOutlineLight}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="{StaticResource FontSizeLabelSmall}"
                            Foreground="{StaticResource BrushInkMuted}"
                            LineHeight="{StaticResource LineHeightHeaderStatus}"
                            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Button
                    Grid.Column="2"
                    MinHeight="{StaticResource LayoutModelCapsuleMinHeight}"
                    Padding="{StaticResource ThicknessModelCapsule}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="选择模型与提供商"
                    Background="{StaticResource BrushChromeFill}"
                    BorderBrush="{StaticResource BrushChromeHairline}"
                    BorderThickness="{StaticResource BorderHairline}"
                    Click="OnModelClick"
                    CornerRadius="{StaticResource RadiusCapsule}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource LayoutStatusDotGap}" VerticalAlignment="Center">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="{StaticResource FontSizeModelChip}"
                            Foreground="{StaticResource BrushInkMuted}"
                            LineHeight="{StaticResource LineHeightModelChip}"
                            Text="{x:Bind ViewModel.ModelLabel, Mode=OneWay}" />
                        <FontIcon
                            FontFamily="{StaticResource FontIcon}"
                            FontSize="{StaticResource LayoutModelChevronSize}"
                            Foreground="{StaticResource BrushInkFaint}"
                            Glyph="&#xE70D;" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- §2.1 消息列表：阅读列 720 居中 -->
            <Grid Grid.Row="1">
                <ScrollViewer
                    x:Name="MessageScroll"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    ViewChanged="OnMessageScrollViewChanged">
                    <Grid
                        x:Name="ReadingColumn"
                        MaxWidth="{StaticResource SpaceReadingWidth}"
                        Margin="{StaticResource ThicknessListInset}">
                        <ItemsRepeater
                            x:Name="MessagesRepeater"
                            ItemsSource="{x:Bind ViewModel.Messages}"
                            ItemTemplate="{StaticResource MessageTemplate}"
                            ElementClearing="OnMessageElementClearing"
                            ElementPrepared="OnMessageElementPrepared" />
                    </Grid>
                </ScrollViewer>

                <!-- §3.3 空态 -->
                <StackPanel
                    MaxWidth="{StaticResource LayoutEmptyMaxWidth}"
                    Margin="{StaticResource ThicknessEmptyColumn}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="{StaticResource FontSizeDisplaySmall}"
                        FontWeight="{StaticResource WeightLight}"
                        Foreground="{StaticResource BrushInk}"
                        LineHeight="{StaticResource LineHeightDisplaySmall}"
                        Text="你好，我是 NeoChat" />
                    <TextBlock
                        Margin="{StaticResource MarginSubtitleTop}"
                        HorizontalAlignment="Center"
                        FontSize="{StaticResource FontSizeBodyLarge}"
                        Foreground="{StaticResource BrushInkFaint}"
                        LineHeight="{StaticResource LineHeightBodyLarge}"
                        Text="选一个方向开始，或直接在下方输入。" />
                    <Button
                        MinHeight="{StaticResource LayoutEmptyCapsuleHeight}"
                        Margin="{StaticResource MarginCapsuleTop}"
                        Padding="{StaticResource ThicknessEmptyCapsule}"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="开始新对话"
                        Background="{StaticResource BrushSeed}"
                        Click="OnStartConversationClick"
                        CornerRadius="{StaticResource RadiusCapsule}"
                        Foreground="{StaticResource BrushOnSeed}">
                        <TextBlock
                            FontSize="{StaticResource FontSizeBodyMedium}"
                            FontWeight="{StaticResource WeightSemiBold}"
                            LineHeight="{StaticResource LineHeightBodyMedium}"
                            Text="开始新对话" />
                    </Button>
                    <StackPanel
                        Margin="{StaticResource MarginSuggestionsTop}"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="{StaticResource LayoutEmptyChipGap}">
                        <Button
                            MinHeight="{StaticResource LayoutEmptyChipHeight}"
                            Padding="{StaticResource ThicknessEmptyChip}"
                            AutomationProperties.Name="建议：总结一段长文"
                            Background="{StaticResource BrushCardFill}"
                            BorderBrush="{StaticResource BrushCardHairline}"
                            BorderThickness="{StaticResource BorderHairline}"
                            Click="OnSuggestionClick"
                            Content="总结一段长文"
                            CornerRadius="{StaticResource RadiusMd}"
                            FontSize="{StaticResource FontSizeBodyMedium}"
                            Foreground="{StaticResource BrushInkMuted}"
                            Tag="请总结下面这段内容" />
                        <Button
                            MinHeight="{StaticResource LayoutEmptyChipHeight}"
                            Padding="{StaticResource ThicknessEmptyChip}"
                            AutomationProperties.Name="建议：解释一段代码"
                            Background="{StaticResource BrushCardFill}"
                            BorderBrush="{StaticResource BrushCardHairline}"
                            BorderThickness="{StaticResource BorderHairline}"
                            Click="OnSuggestionClick"
                            Content="解释一段代码"
                            CornerRadius="{StaticResource RadiusMd}"
                            FontSize="{StaticResource FontSizeBodyMedium}"
                            Foreground="{StaticResource BrushInkMuted}"
                            Tag="请解释这段代码" />
                        <Button
                            MinHeight="{StaticResource LayoutEmptyChipHeight}"
                            Padding="{StaticResource ThicknessEmptyChip}"
                            AutomationProperties.Name="建议：把这段话翻译成英文"
                            Background="{StaticResource BrushCardFill}"
                            BorderBrush="{StaticResource BrushCardHairline}"
                            BorderThickness="{StaticResource BorderHairline}"
                            Click="OnSuggestionClick"
                            Content="翻译成英文"
                            CornerRadius="{StaticResource RadiusMd}"
                            FontSize="{StaticResource FontSizeBodyMedium}"
                            Foreground="{StaticResource BrushInkMuted}"
                            Tag="把下面这段话翻译成英文" />
                    </StackPanel>
                    <TextBlock
                        Margin="{StaticResource MarginHintTop}"
                        HorizontalAlignment="Center"
                        FontSize="{StaticResource FontSizeLabelSmall}"
                        Foreground="{StaticResource BrushInkFaint}"
                        LineHeight="{StaticResource LineHeightLabelSmall}"
                        Text="Enter 发送 · Shift+Enter 换行" />
                </StackPanel>

                <!-- Y09 回到底部 -->
                <Button
                    x:Name="JumpToBottomButton"
                    Width="{StaticResource LayoutComposerKeySize}"
                    Height="{StaticResource LayoutComposerKeySize}"
                    Margin="{StaticResource MarginJumpToBottom}"
                    Padding="{StaticResource ThicknessZero}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    AutomationProperties.Name="回到底部"
                    Background="{StaticResource BrushChromeFill}"
                    BorderBrush="{StaticResource BrushChromeHairline}"
                    BorderThickness="{StaticResource BorderHairline}"
                    Click="OnJumpToBottomClick"
                    CornerRadius="{StaticResource RadiusCapsule}"
                    Visibility="Collapsed">
                    <FontIcon
                        FontFamily="{StaticResource FontIcon}"
                        FontSize="{StaticResource LayoutIconGlyphSize}"
                        Foreground="{StaticResource BrushInkMuted}"
                        Glyph="&#xE70D;" />
                </Button>
            </Grid>

            <!-- §3.4 错误横幅 + §2.2 输入栏 -->
            <StackPanel
                Grid.Row="2"
                MaxWidth="{StaticResource SpaceFloatingWidth}"
                Margin="{StaticResource MarginFloatingInsets}"
                HorizontalAlignment="Center">
                <Border
                    Margin="{StaticResource ThicknessErrorBannerOuter}"
                    Padding="{StaticResource ThicknessErrorBanner}"
                    Background="{StaticResource BrushErrorBannerFill}"
                    BorderBrush="{StaticResource BrushErrorBannerBorder}"
                    BorderThickness="{StaticResource BorderErrorBanner}"
                    CornerRadius="{StaticResource RadiusMd}"
                    Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Top"
                            FontFamily="{StaticResource FontIcon}"
                            FontSize="{StaticResource LayoutErrorIconSize}"
                            Foreground="{StaticResource BrushDanger}"
                            Glyph="&#xEA39;" />
                        <StackPanel Grid.Column="1" Margin="{StaticResource ThicknessErrorText}">
                            <TextBlock
                                x:Name="ErrorTitleText"
                                FontSize="{StaticResource FontSizeBodySmall}"
                                FontWeight="{StaticResource WeightSemiBold}"
                                Foreground="{StaticResource BrushOnDangerContainer}"
                                LineHeight="{StaticResource LineHeightBodySmall}"
                                MaxLines="{StaticResource LayoutErrorMaxTextLinesInt}"
                                TextWrapping="Wrap" />
                            <ItemsControl x:Name="ErrorCausesHost" Margin="{StaticResource MarginXs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock
                                            FontSize="{StaticResource FontSizeLabelSmall}"
                                            Foreground="{StaticResource BrushOnDangerContainer}"
                                            LineHeight="{StaticResource LineHeightLabelSmall}"
                                            Text="{Binding}"
                                            TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel
                                x:Name="ErrorActionsHost"
                                Margin="{StaticResource MarginXs}"
                                Orientation="Horizontal"
                                Spacing="{StaticResource SpaceXs}" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Width="{StaticResource LayoutErrorCloseSize}"
                            Height="{StaticResource LayoutErrorActionMinSize}"
                            Padding="{StaticResource ThicknessZero}"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="关闭错误提示"
                            Background="{StaticResource BrushTransparent}"
                            BorderThickness="0"
                            Click="OnDismissErrorClick">
                            <FontIcon
                                FontFamily="{StaticResource FontIcon}"
                                FontSize="{StaticResource LayoutErrorCloseIconSize}"
                                Foreground="{StaticResource BrushOnDangerContainer}"
                                Glyph="&#xE711;" />
                        </Button>
                    </Grid>
                </Border>

                <Border
                    x:Name="ComposerShell"
                    MinHeight="{StaticResource LayoutComposerHeight}"
                    Padding="{StaticResource ThicknessComposer}"
                    Background="{StaticResource BrushChromeFill}"
                    BorderBrush="{StaticResource BrushChromeHairline}"
                    BorderThickness="{StaticResource BorderHairline}"
                    CornerRadius="{StaticResource RadiusXl}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="ComposerInput"
                            Grid.Column="0"
                            MinHeight="{StaticResource LayoutComposerKeySize}"
                            MaxHeight="{StaticResource LayoutComposerMaxHeight}"
                            Padding="{StaticResource ThicknessComposerText}"
                            AcceptsReturn="True"
                            AutomationProperties.Name="消息输入"
                            Background="{StaticResource BrushTransparent}"
                            BorderThickness="0"
                            FontSize="{StaticResource FontSizeComposer}"
                            Foreground="{StaticResource BrushInk}"
                            KeyDown="OnComposerKeyDown"
                            Text="{x:Bind ViewModel.ComposerText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"
                            VerticalContentAlignment="Top">
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource ColorTransparent}" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource ColorTransparent}" />
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource ColorTransparent}" />
                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource ColorTransparent}" />
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource ColorTransparent}" />
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource ColorTransparent}" />
                            </TextBox.Resources>
                        </TextBox>
                        <Button
                            x:Name="SendKey"
                            Grid.Column="1"
                            Width="{StaticResource LayoutComposerKeySize}"
                            Height="{StaticResource LayoutComposerKeySize}"
                            Padding="{StaticResource ThicknessZero}"
                            VerticalAlignment="Bottom"
                            AutomationProperties.Name="发送"
                            Background="{StaticResource BrushSeed}"
                            Click="OnSendKeyClick"
                            CornerRadius="{StaticResource RadiusCapsule}">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource ColorSeedPressed}" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource ColorSeedPressed}" />
                                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{StaticResource ColorSendDisabled}" />
                                <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{StaticResource ColorSendForegroundDisabled}" />
                            </Button.Resources>
                            <FontIcon
                                x:Name="SendKeyGlyph"
                                FontFamily="{StaticResource FontIcon}"
                                FontSize="{StaticResource LayoutComposerIconSize}"
                                Foreground="{StaticResource BrushOnSeed}"
                                Glyph="&#xE724;" />
                        </Button>
                    </Grid>
                </Border>

                <TextBlock
                    Margin="{StaticResource MarginFloatingFooter}"
                    HorizontalAlignment="Right"
                    FontSize="{StaticResource FontSizeLabelSmall}"
                    Foreground="{StaticResource BrushInkFaint}"
                    LineHeight="{StaticResource LineHeightLabelSmall}"
                    Text="{x:Bind ViewModel.CharacterCountText, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.ShowCharacterCount, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
