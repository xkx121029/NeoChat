{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neochat.app/spec/schema/export-v1.json",
  "title": "NeoChat Export Bundle v1",
  "description": "无损导出/导入格式。字段名与 spec/schema/v1.sql 的列名完全一致（snake_case），以减少映射层缺陷；这是刻意的取舍，见 export-v1.notes.md §1。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "exported_at",
    "app",
    "options",
    "integrity",
    "data"
  ],
  "properties": {
    "format": {
      "const": "neochat-export"
    },
    "format_version": {
      "const": 1
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "app": {
      "$ref": "#/$defs/app"
    },
    "options": {
      "$ref": "#/$defs/export_options"
    },
    "integrity": {
      "$ref": "#/$defs/integrity"
    },
    "secrets": {
      "$ref": "#/$defs/secrets"
    },
    "data": {
      "$ref": "#/$defs/data"
    }
  },
  "$defs": {
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "schema_version",
        "platform"
      ],
      "properties": {
        "name": {
          "const": "NeoChat"
        },
        "version": {
          "type": "string",
          "examples": [
            "0.1.0"
          ]
        },
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "platform": {
          "enum": [
            "android",
            "windows"
          ]
        },
        "device_label": {
          "type": "string",
          "maxLength": 64
        }
      }
    },
    "export_options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "include_attachments",
        "include_secrets"
      ],
      "properties": {
        "scope": {
          "description": "all = 全库；conversations = 指定会话；settings = 仅配置",
          "enum": [
            "all",
            "conversations",
            "settings"
          ]
        },
        "conversation_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 20000
        },
        "include_attachments": {
          "description": "none = 仅元数据（默认）；inline = 附件字节以 base64 内嵌",
          "enum": [
            "none",
            "inline"
          ]
        },
        "include_secrets": {
          "description": "true 时必须提供 secrets 块（口令加密）。默认 false",
          "type": "boolean"
        },
        "include_reasoning": {
          "description": "是否导出思考内容（message_part.kind='reasoning'）。默认 true",
          "type": "boolean"
        },
        "include_trash": {
          "description": "是否包含回收站（deleted_at 非空）中的数据。默认 true，否则不无损",
          "type": "boolean"
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "counts",
        "sha256"
      ],
      "properties": {
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "sha256": {
          "description": "每个集合序列化后（键排序、无空白）的 SHA-256，用于往返校验",
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kdf",
        "cipher",
        "ciphertext_b64"
      ],
      "properties": {
        "kdf": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algo",
            "salt_b64"
          ],
          "properties": {
            "algo": {
              "enum": [
                "argon2id",
                "pbkdf2-sha256"
              ]
            },
            "m_kib": {
              "type": "integer",
              "minimum": 8192
            },
            "t": {
              "type": "integer",
              "minimum": 1
            },
            "p": {
              "type": "integer",
              "minimum": 1
            },
            "iterations": {
              "type": "integer",
              "minimum": 600000,
              "description": "PBKDF2 迭代次数下限 600000（ADR-002）；argon2id 时由 m_kib/t/p 表达"
            },
            "salt_b64": {
              "type": "string",
              "contentEncoding": "base64"
            }
          }
        },
        "cipher": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algo",
            "nonce_b64",
            "tag_b64"
          ],
          "properties": {
            "algo": {
              "const": "AES-256-GCM"
            },
            "nonce_b64": {
              "type": "string",
              "contentEncoding": "base64"
            },
            "tag_b64": {
              "type": "string",
              "contentEncoding": "base64"
            }
          }
        },
        "ciphertext_b64": {
          "description": "解密后为 provider_key 的明文 JSON 数组。AAD 唯一定义：{format, format_version, app, options, secrets.kdf, secrets.cipher} 的规范化 JSON（键排序、无空白、UTF-8）。notes §5 与 ADR-002 必须与本定义一致，任何一方多一项或少一项都会导致跨端 GCM 校验失败。",
          "type": "string",
          "contentEncoding": "base64"
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providers",
        "models",
        "conversations",
        "messages",
        "message_parts"
      ],
      "properties": {
        "providers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provider"
          }
        },
        "provider_keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provider_key"
          }
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/model"
          }
        },
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/agent"
          }
        },
        "prompts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/prompt"
          }
        },
        "memories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memory"
          }
        },
        "folders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/folder"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tag"
          }
        },
        "conversation_tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conversation_tag"
          }
        },
        "conversations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conversation"
          }
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/message"
          }
        },
        "message_parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/message_part"
          }
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attachment"
          }
        },
        "message_attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/message_attachment"
          }
        },
        "usage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/usage_record"
          }
        },
        "mcp_servers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mcp_server"
          }
        },
        "mcp_tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mcp_tool"
          }
        },
        "tool_calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tool_call"
          }
        },
        "settings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/setting"
          }
        },
        "tombstones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tombstone"
          }
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "protocol",
        "base_url",
        "created_at",
        "updated_at",
        "sync_version",
        "rev",
        "proxy_mode",
        "connect_timeout_ms",
        "read_idle_timeout_ms",
        "max_retries",
        "concurrency_limit",
        "pass_through",
        "sort_order",
        "first_byte_timeout_ms",
        "total_timeout_ms",
        "cumulative_stream"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "protocol": {
          "enum": [
            "openai_chat",
            "openai_responses",
            "anthropic",
            "gemini",
            "openrouter",
            "openai_compatible"
          ]
        },
        "base_url": {
          "type": "string",
          "maxLength": 2048
        },
        "org_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "proxy_mode": {
          "enum": [
            "system",
            "none",
            "http",
            "socks5"
          ]
        },
        "proxy_url": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        },
        "connect_timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        },
        "read_idle_timeout_ms": {
          "type": "integer",
          "minimum": 30000,
          "maximum": 900000
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "concurrency_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "extra_headers_json": {
          "type": [
            "string",
            "null"
          ]
        },
        "extra_query_json": {
          "type": [
            "string",
            "null"
          ]
        },
        "extra_body_json": {
          "type": [
            "string",
            "null"
          ]
        },
        "pass_through": {
          "type": "boolean"
        },
        "sort_order": {
          "type": "integer"
        },
        "sync_version": {
          "type": "integer",
          "minimum": 1
        },
        "rev": {
          "type": "string",
          "maxLength": 64
        },
        "origin_device": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "created_at": {
          "type": "integer"
        },
        "updated_at": {
          "type": "integer"
        },
        "deleted_at": {
          "type": [
            "integer",
            "null"
          ]
        },
        "first_byte_timeout_ms": {
          "type": "integer",
          "minimum": 5000,
          "maximum": 300000
        },
        "total_timeout_ms": {
          "oneOf": [
            {
              "const": 0
            },
            {
              "type": "integer",
              "minimum": 30000
            }
          ],
          "description": "0 = 不限；否则 ≥30000，与 DDL CHECK (=0 OR >=30000) 一致"
        },
        "billing_url": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048,
          "description": "NULL 表示 top_up 不出现"
        },
        "status_url": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048,
          "description": "NULL 表示 view_service_status 不出现"
        },
        "cumulative_stream": {
          "type": "boolean",
          "description": "端点为累积型文本流"
        }
      }
    },
    "provider_key": {
      "description": "密钥本体永不进入导出数据的明文部分。导出密钥时，明文 key 只出现在 secrets.ciphertext_b64 解密后的载荷里。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider_id",
        "hint_head",
        "hint_tail",
        "created_at",
        "updated_at",
        "label",
        "health_score",
        "failure_count",
        "enabled"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "provider_id": {
          "$ref": "#/$defs/uuid"
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "hint_head": {
          "type": "string",
          "maxLength": 4
        },
        "hint_tail": {
          "type": "string",
          "maxLength": 4
        },
        "health_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cooldown_until": {
          "type": [
            "integer",
            "null"
          ]
        },
        "rpm_limit": {
          "type": [
            "integer",
            "null"
          ]
        },
        "tpm_limit": {
          "type": [
            "integer",
            "null"
          ]
        },
        "daily_request_limit": {
          "type": [
            "integer",
            "null"
          ]
        },
        "failure_count": {
          "type": "integer",
          "minimum": 0
        },
        "enabled": {
          "type": "boolean"
        },
        "last_used_at": {
          "type": [
            "integer",
            "null"
          ]
        },
        "created_at": {
          "type": "integer"
        },
        "updated_at": {
          "type": "integer"
        },
        "deleted_at": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider_id",
        "model_key",
        "display_name",
        "sync_version",
        "rev",
        "supports_vision",
        "supports_tools",
        "supports_thinking",
        "supports_cache",
        "supports_json_schema",
        "max_tokens_param",
        "currency",
        "is_custom",
        "pinned_by_user",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "provider_id": {
          "$ref": "#/$defs/uuid"
        },
        "model_key": {
          "type": "string",
          "maxLength": 200
        },
        "display_name": {
          "type": "string",
          "maxLength": 200
        },
        "context_window": {
          "type": [
            "integer",
            "null"
          ]
        },
        "max_output": {
          "type": [
            "integer",
            "null"
          ]
        },
        "supports_vision": {
          "type": "boolean"
        },
        "supports_tools": {
          "type": "boolean"
        },
        "supports_thinking": {
          "type": "boolean"
        },
        "supports_cache": {
          "type": "boolean"
        },
        "supports_json_schema": {
          "type": "boolean"
        },
        "max_tokens_param": {
          "enum": [
            "max_tokens",
            "max_completion_tokens"
          ]
        },
        "price_input": {
          "type": [
            "number",
            "null"
          ]
        },
        "price_output": {
          "type": [
            "number",
            "null"
          ]
        },
        "price_cache_read": {
          "type": [
            "number",
            "null"
          ]
        },
        "price_cache_write": {
          "type": [
            "number",
            "null"
          ]
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "thinking_budget_max": {
          "type": [
            "integer",
            "null"
          ]
        },
        "is_custom": {
          "type": "boolean"
        },
        "pinned_by_user": {
          "type": "boolean"
        },
        "extra_json": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": "integer"
        },
        "updated_at": {
          "type": "integer"
        },
        "deleted_at": {
          "type": [
            "integer",
            "null"
          ]
        },
        "sync_version": {
          "type": "integer",
          "minimum": 1
        },
        "rev": {
          "type": "string",
          "maxLength": 64
        },
        "origin_device": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "system_prompt",
        "sync_version",
        "rev",
        "memory_scope",
        "sort_order",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "avatar_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "system_prompt": {
          "type": "string"
        },
        "default_model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "sampling_json": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_allow_json": {
          "type": [
            "string",
            "null"
          ]
        },
        "mcp_server_ids_json": {
          "type": [
            "string",
            "null"
          ]
        },
        "greeting": {
          "type": [
            "string",
            "null"
          ]
        },
        "context_policy_json": {
          "type": [
            "string",
            "null"
          ]
        },
        "memory_scope": {
          "enum": [
            "agent",
            "global",
            "off"
          ]
        },
        "sort_order": {
          "type": "integer"
        },
        "created_at": {
          "type": "integer"
        },
        "updated_at": {
          "type": "integer"
        },
        "deleted_at": {
          "type": [
            "integer",
            "null"
          ]
        },
        "sync_version": {
          "type": "integer",
          "minimum": 1
        },
        "rev": {
          "type": "string",
          "maxLength": 64
        },
        "origin_device": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "body",
        "sync_version",
        "rev",
        "sort_order",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "body": {
          "type": "string"
        },
        "variables_json": {
          "type": [
            "string",
            "null"
          ]
        },
        "sort_order": {
          "type": "integer"
        },
        "created_at": {
          "type": "integer"
        },
        "updated_at": {
          "type": "integer"
        },
        "deleted_at": {
          "type": [
            "integer",
            "null"
          ]
        },
        "sync_version": {
          "type": "integer",
          "minimum": 1
        },
        "rev": {
          "type": "string",
          "maxLength": 64
        },
        "origin_device": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scope",
        "content",
        "sync_version",
        "rev",
        "pinned",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "scope": {
          "enum": [
            "agent",
            "global"
          ]
        },
        "agent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "content": {
          "type": "string",
          "maxLength": 20000
        },
        "keywords": {
          "type": [
            "string",
            "null"
          ]
        },
        "pinned": {
          "type": "boolean"
        },
        "source_conversation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_message_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": "integer"
        },
        "updated_at": {
          "type": "integer"
        },
        "deleted_at": {
          "type": [
            "integer",
            "null"
          ]
        },
        "sync_version": {
          "type": "integer",
          "minimum": 1
        },
        "rev": {
          "type": "string",
          "maxLength": 64
        },
        "origin_device": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        }
      }
    },
    "folder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "sort_order",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "sort_order": {
          "type": "integer"
        },
        "created_at": {
          "type": "integer"
        },
        "updated_at": {
          "type": "integer"
        },
        "deleted_at": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "tag": {
      "type": "object",
