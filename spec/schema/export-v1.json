          "description": "仅当 options.include_attachments='inline' 时出现",
          "type": "string",
          "contentEncoding": "base64"
        },
        "content_omitted": {
          "type": "boolean",
          "description": "inline 模式因超过 20MB 未内嵌字节时为 true；与 content_b64 互斥"
        }
      }
